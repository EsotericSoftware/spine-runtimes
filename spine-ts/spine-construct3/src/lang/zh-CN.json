          "spine-scale-y": {
            "name": "Y缩放",
            "desc": "Y缩放"
          },
          "spine-debug-skeleton": {
            "name": "调试骨架",
            "desc": "绘制骨架骨骼的调试可视化"
          },
          "spine-bounds-offset-x": {
            "name": "X偏移",
            "desc": "X偏移"
