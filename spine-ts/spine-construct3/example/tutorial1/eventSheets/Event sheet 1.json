			"actions": [
				{
					"type": "script",
					"language": "typescript",
					"script": [
						"const spine = runtime.objects.Spine.getFirstInstance() as any;",
						"const sprite = runtime.objects.Sprite.getFirstInstance();",
						"const textInput = runtime.objects.TextInput.getFirstInstance();",
						"",
						"if (spine && sprite && textInput) {",
						"  if (",
						"    spine.skeletonLoaded &&",
						"    sprite.getBoundingBox().left <= spine.getBoundingBox().left &&",
						"    sprite.getBoundingBox().top <= spine.getBoundingBox().top &&",
						"    sprite.getBoundingBox().bottom >= spine.getBoundingBox().bottom &&",
						"    sprite.getBoundingBox().right >= spine.getBoundingBox().right",
						"  ) {",
						"    textInput.text = \"Spineboy is inside the yellow rectangle\";",
						"  } else {",
						"    textInput.text = \"Spineboy is not inside the yellow rectangle\";",
						"  }",
						"}"
					]
				}
			],
			"sid": 738069846728658
		},
