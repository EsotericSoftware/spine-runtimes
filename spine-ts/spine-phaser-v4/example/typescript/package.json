{
  "name": "spine-phaser-v4-typescript-example",
  "description": "TypeScript example for the Spine Phaser v4 runtime.",
  "authors": "Esoteric Software LLC",
  "version": "1.0.0",
  "scripts": {
    "build": "npx esbuild index.ts --bundle --sourcemap --outfile=build/index.js --alias:phaser=phaser",
    "dev": "npx concurrently \"npx live-server --no-browser\" \"npm run build -- --watch\""
  },
  "dependencies": {
    "@esotericsoftware/spine-phaser-v4": "file://../../",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.6",
    "concurrently": "^9.2.0",
    "live-server": "^1.2.2"
  }
}
